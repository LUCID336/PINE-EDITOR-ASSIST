//@version=6
indicator("Lab 13 | Parity probe")
int lengthInput = input.int(20, "Length", minval = 1, maxval = 200)
float builtinMean = ta.sma(close, lengthInput)
float manualMean = na
if bar_index >= lengthInput - 1
    float total = 0.0
    for i = 0 to lengthInput - 1
        total += close[i]
    manualMean := total / lengthInput
plot(math.abs(manualMean - builtinMean), "Absolute error")
plot(builtinMean, "Built-in mean", display = display.data_window)
