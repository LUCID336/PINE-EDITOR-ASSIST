//@version=6
indicator("Lab V5 indicator reference probe")
float fastEma = ta.ema(close, 10)
float slowEma = ta.ema(close, 30)
plot(ta.sma(close, 20), "sma20")
plot(ta.ema(close, 20), "ema20")
plot(ta.rma(close, 14), "rma14")
plot(ta.rsi(close, 14), "rsi14")
plot(ta.atr(14), "atr14")
plot(ta.tr(true), "tr_handle_na")
plot(ta.highest(high, 10), "highest10")
plot(ta.lowest(low, 10), "lowest10")
plot(ta.stdev(close, 20), "stdev20")
plot(ta.change(close), "change1")
plot(ta.cum(volume), "cum_volume")
plot(ta.crossover(fastEma, slowEma) ? 1 : 0, "crossover_10_30")
plot(ta.crossunder(fastEma, slowEma) ? 1 : 0, "crossunder_10_30")
var int bullCount = 0
if close > open
    bullCount += 1
plot(bullCount, "var_bull_count")
var array<float> buf = array.new<float>()
buf.push(close)
if buf.size() > 5
    buf.shift()
plot(buf.size() == 5 ? buf.avg() : na, "array_mean5")
plot(ta.pivothigh(high, 2, 2), "pivothigh_2_2")
plot(ta.pivotlow(low, 2, 2), "pivotlow_2_2")
plot(request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on), "htf_d_prev_close")
plot(request.security(syminfo.tickerid, "D", close), "htf_d_close_default")
plot(request.security(syminfo.tickerid, "240", high[1], lookahead = barmerge.lookahead_on), "htf_4h_prev_high")
array<float> ltf = request.security_lower_tf(syminfo.tickerid, "15", close)
plot(ltf.size(), "ltf15_count")
plot(ltf.size() > 0 ? ltf.last() : na, "ltf15_last")
