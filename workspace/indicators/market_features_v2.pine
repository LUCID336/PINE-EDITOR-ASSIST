//@version=6
indicator("Market Features v2 | Human + AI", shorttitle = "MF v2", overlay = true, max_labels_count = 50)
// Pine Engineering Lab V5. One feature core, two presentations:
//   HUMAN: overlay EMA, confirmed swing level, compact status table (text, not color only).
//   AI:    JSON feature event (schema 2.0) per CONFIRMED bar via alert(); optional log.info copy for local tests.
// Temporal contract: every feature is known at the close of the bar it is stamped with (bar_close_ms).
// HTF values use the previous completed HTF bar (close[1] + lookahead_on, TradingView-verified semantics).
// Swing levels are reported on their observation bar (right-bar delay), never backdated.

// ---------------- Inputs ----------------
const string GRP_F = "Features"
const string GRP_H = "Human view"
const string GRP_A = "AI export"
int    emaLenInput   = input.int(20, "EMA length", minval = 1, group = GRP_F)
int    rsiLenInput   = input.int(14, "RSI length", minval = 1, group = GRP_F)
int    atrLenInput   = input.int(14, "ATR length", minval = 1, group = GRP_F)
int    volLenInput   = input.int(20, "Volume baseline length", minval = 1, group = GRP_F)
string htfInput      = input.timeframe("D", "Higher timeframe", group = GRP_F, tooltip = "Must be higher than the chart timeframe; otherwise HTF features are null and quality is MISSING.")
int    htfEmaInput   = input.int(10, "HTF EMA length", minval = 1, group = GRP_F)
int    swingLenInput = input.int(3, "Swing strength (left = right bars)", minval = 1, maxval = 20, group = GRP_F)
bool   showVisInput  = input.bool(true, "Show overlay (EMA + swing level)", group = GRP_H)
bool   showTblInput  = input.bool(true, "Show status table", group = GRP_H)
bool   emitAlertInput = input.bool(false, "Emit JSON alert per confirmed bar", group = GRP_A, tooltip = "Create the alert with 'Any alert() function call'. Off by default.")
bool   emitLogInput  = input.bool(false, "Also write JSON to Pine Logs (testing)", group = GRP_A)
string buildInput    = input.string("mf-2.0.0", "Build id", group = GRP_A)

// ---------------- Feature core (unconditional, every bar) ----------------
float ema   = ta.ema(close, emaLenInput)
float rsi   = ta.rsi(close, rsiLenInput)
float atr   = ta.atr(atrLenInput)
float vBase = ta.sma(volume, volLenInput)

safeRatio(float num, float den) =>
    na(num) or na(den) or den == 0 ? na : num / den

float atrPct = 100.0 * safeRatio(atr, close)
float rvol   = safeRatio(volume, vBase)

bool  htfValid = timeframe.in_seconds(htfInput) > timeframe.in_seconds()
float htfClosePrev = request.security(syminfo.tickerid, htfInput, close[1], lookahead = barmerge.lookahead_on)
float htfEmaPrev   = request.security(syminfo.tickerid, htfInput, ta.ema(close, htfEmaInput)[1], lookahead = barmerge.lookahead_on)
float htfClose = htfValid ? htfClosePrev : na
float htfTrend = htfValid and not na(htfClosePrev) and not na(htfEmaPrev) ? (htfClosePrev > htfEmaPrev ? 1.0 : -1.0) : na

float pivotHigh = ta.pivothigh(high, swingLenInput, swingLenInput)
var float swingHigh = na
if barstate.isconfirmed and not na(pivotHigh)
    swingHigh := pivotHigh
float distSwingAtr = safeRatio(close - swingHigh, atr)

bool ready = not na(ema) and not na(rsi) and not na(atrPct) and not na(rvol) and not na(htfClose) and not na(htfTrend) and not na(swingHigh)

// ---------------- Human view ----------------
plot(showVisInput ? ema : na, "EMA", color = color.new(color.blue, 0), linewidth = 2)
plot(showVisInput ? swingHigh : na, "Swing high (confirmed)", color = color.new(color.gray, 0), style = plot.style_stepline)
var table panel = table.new(position.top_right, 2, 5, border_width = 1)
if showTblInput and barstate.islast
    table.cell(panel, 0, 0, "Quality", text_size = size.small)
    table.cell(panel, 1, 0, ready ? "READY" : "MISSING", text_size = size.small, bgcolor = ready ? color.new(color.green, 70) : color.new(color.orange, 60))
    table.cell(panel, 0, 1, "Bar", text_size = size.small)
    table.cell(panel, 1, 1, barstate.isconfirmed ? "CLOSED" : "OPEN (provisional)", text_size = size.small)
    table.cell(panel, 0, 2, "HTF trend", text_size = size.small)
    table.cell(panel, 1, 2, na(htfTrend) ? "n/a" : htfTrend > 0 ? "UP" : "DOWN", text_size = size.small)
    table.cell(panel, 0, 3, "RSI", text_size = size.small)
    table.cell(panel, 1, 3, na(rsi) ? "n/a" : str.tostring(rsi, "#.0"), text_size = size.small)
    table.cell(panel, 0, 4, "ATR %", text_size = size.small)
    table.cell(panel, 1, 4, na(atrPct) ? "n/a" : str.tostring(atrPct, "#.00"), text_size = size.small)

// ---------------- AI view: machine-readable plots (same variables as JSON) ----------------
plot(ema, "f_ema", display = display.data_window)
plot(rsi, "f_rsi", display = display.data_window)
plot(atrPct, "f_atr_pct", display = display.data_window)
plot(rvol, "f_rvol", display = display.data_window)
plot(htfClose, "f_htf_close", display = display.data_window)
plot(htfTrend, "f_htf_trend", display = display.data_window)
plot(swingHigh, "f_swing_high", display = display.data_window)
plot(distSwingAtr, "f_dist_swing_atr", display = display.data_window)
plot(ready ? 1 : 0, "quality_ready", display = display.data_window)

// ---------------- AI view: JSON event (schema 2.0) ----------------
jsonNum(float x) =>
    na(x) ? "null" : str.tostring(x, "0.##########")
jsonStr(string s) =>
    '"' + str.replace_all(str.replace_all(s, "\\", "\\\\"), '"', '\\"') + '"'

string configId = "e" + str.tostring(emaLenInput) + "_r" + str.tostring(rsiLenInput) + "_a" + str.tostring(atrLenInput) + "_v" + str.tostring(volLenInput) + "_h" + htfInput + "_he" + str.tostring(htfEmaInput) + "_s" + str.tostring(swingLenInput)
if barstate.isconfirmed and (emitAlertInput or emitLogInput)
    string msg = '{"schema_version":"2.0","build":' + jsonStr(buildInput) + ',"config_id":' + jsonStr(configId) + ',"symbol":' + jsonStr(syminfo.tickerid) + ',"timeframe":' + jsonStr(timeframe.period) + ',"bar_open_ms":' + str.tostring(time) + ',"bar_close_ms":' + str.tostring(time_close) + ',"confirmed":true,"quality":' + jsonStr(ready ? "READY" : "MISSING") + ',"features":{"ema":' + jsonNum(ema) + ',"rsi":' + jsonNum(rsi) + ',"atr_pct":' + jsonNum(atrPct) + ',"rvol":' + jsonNum(rvol) + ',"htf_close":' + jsonNum(htfClose) + ',"htf_trend":' + jsonNum(htfTrend) + ',"swing_high":' + jsonNum(swingHigh) + ',"dist_swing_atr":' + jsonNum(distSwingAtr) + '}}'
    if emitAlertInput
        alert(msg, alert.freq_once_per_bar_close)
    if emitLogInput
        log.info(msg)
