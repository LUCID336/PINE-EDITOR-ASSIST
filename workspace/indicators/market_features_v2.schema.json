{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pinelab/market-feature-event/2.0",
  "title": "Market feature event v2 (Pine Engineering Lab V5)",
  "description": "One event per confirmed chart bar. Values known at bar_close_ms. Missing = JSON null (never 0, NaN or string). Units: ema, htf_close, swing_high in quote price; rsi 0-100; atr_pct percent of close; rvol dimensionless (volume / SMA volume); htf_trend +1 up / -1 down (previous completed HTF bar close vs its EMA); dist_swing_atr = (close - last confirmed swing high) / ATR. Dedup key: build, config_id, symbol, timeframe, bar_open_ms. Extends V3 schema 1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build", "config_id", "symbol", "timeframe", "bar_open_ms", "bar_close_ms", "confirmed", "quality", "features"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "build": {"type": "string", "minLength": 1},
    "config_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "timeframe": {"type": "string", "minLength": 1},
    "bar_open_ms": {"type": "integer", "minimum": 0},
    "bar_close_ms": {"type": "integer", "minimum": 0},
    "confirmed": {"const": true},
    "quality": {"enum": ["READY", "MISSING"]},
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ema", "rsi", "atr_pct", "rvol", "htf_close", "htf_trend", "swing_high", "dist_swing_atr"],
      "properties": {
        "ema": {"type": ["number", "null"]},
        "rsi": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "atr_pct": {"type": ["number", "null"], "minimum": 0},
        "rvol": {"type": ["number", "null"], "minimum": 0},
        "htf_close": {"type": ["number", "null"]},
        "htf_trend": {"enum": [1, -1, null]},
        "swing_high": {"type": ["number", "null"]},
        "dist_swing_atr": {"type": ["number", "null"]}
      }
    }
  }
}
